@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="shinobi-hero">

    <div class="container">

        <div class="row align-items-center min-vh-75">

            <div class="col-lg-7">

                @if (User.Identity != null &&
                                User.Identity.IsAuthenticated &&
                                User.IsInRole("Admin"))
                {
                    <!-- ADMIN HERO -->

                    <p class="shinobi-accent-text">
                        THEE SHINOBI ADMINISTRATION
                    </p>

                    <h1 class="shinobi-hero-title">
                        WELCOME BACK.
                        <br />
                        <span>ADMIN.</span>
                    </h1>

                    <p class="shinobi-hero-text">
                        Manage Thee Shinobi products, categories and
                        customer orders from the administration dashboard.
                    </p>

                    <div class="mt-4">

                        <a asp-controller="Admin"
                           asp-action="Index"
                           class="btn shinobi-btn-orange">
                            ADMIN DASHBOARD
                        </a>

                    </div>
                }
                else
                {
                    <!-- CUSTOMER / GUEST HERO -->

                    <p class="shinobi-accent-text">
                        THEE SHINOBI
                    </p>

                    <h1 class="shinobi-hero-title">
                        MOVE DIFFERENT.
                        <br />
                        <span>STAY SHINOBI.</span>
                    </h1>

                    <p class="shinobi-hero-text">
                        Discover Thee Shinobi — a South African streetwear brand
                        built around individuality, confidence and a style that
                        refuses to blend in.
                    </p>

                    <div class="mt-4">

                        <a asp-controller="Product"
                           asp-action="Index"
                           class="btn shinobi-btn-orange me-2">
                            SHOP NOW
                        </a>

                        <a asp-controller="Product"
                           asp-action="Index"
                           class="btn shinobi-btn-outline">
                            VIEW COLLECTION
                        </a>

                    </div>
                }

            </div>


            <!-- Hero Visual -->
            <div class="col-lg-5 mt-5 mt-lg-0">

                <div class="shinobi-hero-box">

                    <div class="shinobi-logo-mark">
                        TS
                    </div>

                    <p>
                        THEE SHINOBI
                    </p>

                    <span>
                        EST. 2026
                    </span>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Brand / Admin Section -->
<section class="shinobi-brand-section">

    <div class="container">

        <div class="row justify-content-center text-center">

            <div class="col-lg-8">

                @if (User.Identity != null &&
                                User.Identity.IsAuthenticated &&
                                User.IsInRole("Admin"))
                {
                    <!-- ADMIN INFORMATION -->

                    <p class="shinobi-accent-text">
                        ADMINISTRATION
                    </p>

                    <h2 class="mb-4">
                        MANAGE THE STORE.
                    </h2>

                    <p class="text-muted">
                        Use the administration area to manage products,
                        categories and customer orders for Thee Shinobi.
                    </p>
                }
                else
                {
                    <!-- CUSTOMER / GUEST INFORMATION -->

                    <p class="shinobi-accent-text">
                        THE SHINOBI MINDSET
                    </p>

                    <h2 class="mb-4">
                        WEAR YOUR IDENTITY.
                    </h2>

                    <p class="text-muted">
                        Thee Shinobi is more than clothing. It represents
                        individuality, confidence and the freedom to create
                        your own identity. Our pieces are designed for people
                        who choose to stand out rather than follow the crowd.
                    </p>
                }

            </div>

        </div>

    </div>

</section>


<!-- Bottom CTA -->
<section class="shinobi-shop-section">

    <div class="container">

        <div class="row align-items-center">

            @if (User.Identity != null &&
                        User.Identity.IsAuthenticated &&
                        User.IsInRole("Admin"))
            {
                <!-- ADMIN CTA -->

                <div class="col-md-8">

                    <p class="shinobi-accent-text">
                        ADMIN CONTROL
                    </p>

                    <h2>
                        RUN THE STORE.
                    </h2>

                    <p>
                        Access products, categories and customer orders
                        from one central location.
                    </p>

                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="btn shinobi-btn-orange">
                        OPEN DASHBOARD
                    </a>

                </div>
            }
            else
            {
                <!-- CUSTOMER / GUEST CTA -->

                <div class="col-md-8">

                    <p class="shinobi-accent-text">
                        YOUR STYLE. YOUR RULES.
                    </p>

                    <h2>
                        FIND YOUR NEXT LOOK.
                    </h2>

                    <p>
                        Explore the latest Thee Shinobi collection.
                    </p>

                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="btn shinobi-btn-orange">
                        EXPLORE THE SHOP
                    </a>

                </div>
            }

        </div>

    </div>

</section>