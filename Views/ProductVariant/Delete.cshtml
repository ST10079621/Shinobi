@model ShinobiClothing.Models.ProductVariant

@{
    ViewData["Title"] = "Delete Variant";
}

<h1>Delete Variant</h1>

<div class="alert alert-danger">

    <h4>Are you sure?</h4>

    <p>
        Product:
        <strong>@Model.Product?.ProductName</strong>
    </p>

    <p>
        Colour:
        <strong>@Model.Colour</strong>
    </p>

    <p>
        Size:
        <strong>@Model.Size</strong>
    </p>

    <p>
        Stock:
        <strong>@Model.StockQuantity</strong>
    </p>

</div>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="ProductVariantId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       asp-route-productId="@Model.ProductId"
       class="btn btn-secondary">
        Cancel
    </a>

</form>